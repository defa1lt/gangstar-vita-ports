# Copy this file to .vita-dev.env and set the Vita address to enable the
# Vita Companion network workflow.  The USB workflow works without VITA_IP.
VITA_IP=
VITA_FTP_PORT=1337
VITA_CMD_PORT=1338
VITA_LOG_PORT=3333

# Optional overrides.  The defaults below are already correct for this repo.
VITA_TITLEID=GSRV00001
VITA_USB_MOUNT=/Volumes/Untitled
VITA_APP_DIR=ux0:/app/GSRV00001
VITA_LOG_REMOTE=ux0:/data/gangstarrio/loader.log
VITA_SDK_PATH=/Volumes/USB/persanal/psvita/.vitasdk-softfp

# Path to the host-side analyzer from TibixDev/vita-crashdump.
VITA_CRASHDUMP=
