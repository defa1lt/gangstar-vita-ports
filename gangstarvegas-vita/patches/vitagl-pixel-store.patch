+#ifndef VGL_PIXEL_LAYOUT_H
+#define VGL_PIXEL_LAYOUT_H
+#include <stdint.h>
+#include <stddef.h>
+#include <string.h>
+
+static inline int vgl_pixel_layout(int width, int height, unsigned bpp,
+                                   int row_length, int alignment,
+                                   uint32_t *stride, uint32_t *span) {
+    if (width < 0 || height < 0 || row_length < 0 || !bpp ||
+        (alignment != 1 && alignment != 2 && alignment != 4 && alignment != 8)) return 0;
+    uint64_t row = (uint64_t)(row_length ? row_length : width) * bpp;
+    row = (row + alignment - 1) & ~(uint64_t)(alignment - 1);
+    uint64_t size = height && width ? (uint64_t)(height - 1) * row + (uint64_t)width * bpp : 0;
+    if (row > UINT32_MAX || size > UINT32_MAX) return 0;
+    *stride = row; *span = size;
+    return 1;
+}
+static inline void vgl_pixel_copy_rows(void *dst, uint32_t dst_stride,
+                                      const void *src, uint32_t src_stride,
+                                      uint32_t row_bytes, int height) {
+    for (int y = 0; y < height; ++y)
+        memcpy((uint8_t *)dst + (size_t)y * dst_stride,
+               (const uint8_t *)src + (size_t)y * src_stride, row_bytes);
+}
+#endif
