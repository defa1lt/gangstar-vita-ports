+static void *read_shader_cache_blob(const char *fname, size_t limit, size_t *size) {
+    SceUID f = sceIoOpen(fname, SCE_O_RDONLY, 0777);
+    if (f < 0) return NULL;
+    SceOff end = sceIoLseek(f, 0, SCE_SEEK_END);
+    if (end <= 0 || (uint64_t)end > limit ||
+        sceIoLseek(f, 0, SCE_SEEK_SET) < 0) {
+        sceIoClose(f);
+        return NULL;
+    }
+    void *blob = vglMalloc((size_t)end);
+    if (!blob) { sceIoClose(f); return NULL; }
+    int read_size = sceIoRead(f, blob, (SceSize)end);
+    sceIoClose(f);
+    if (read_size != end) { vgl_free(blob); return NULL; }
+    *size = (size_t)end;
+    return blob;
+}
